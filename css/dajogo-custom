@media (max-width: 767px) {
    .tm-header-gallery {
        display: flex;
        flex-wrap: wrap; /* Permite que os itens quebrem para a próxima linha */
        justify-content: center; /* Centraliza os itens na linha */
        align-items: flex-start; /* Alinha os itens ao topo, para evitar desalinhamento vertical */
        padding: 5px 0; /* Espaçamento reduzido para o cabeçalho */
        height: auto; /* Garante que a altura se ajuste ao conteúdo */
        overflow: hidden; /* Esconde qualquer conteúdo que transborde */
    }

    /* Estilo para cada "bloco" principal (coluna) dentro da galeria */
    /* Cada um dos 6 divs com classe col- ocupará 1/3 da largura */
    .tm-header-gallery > div[class*="col-"] {
        width: calc(100% / 3); /* 3 blocos por linha */
        max-width: calc(100% / 3);
        padding: 2px; /* Espaçamento entre os blocos */
        box-sizing: border-box;
        flex-shrink: 1; /* Permite que o item encolha se necessário */
        display: flex; /* Transforma o contêiner do bloco em flex para gerenciar seus filhos */
        flex-direction: column; /* Por padrão, empilha os filhos */
        justify-content: center;
        align-items: center;
        overflow: hidden;
        min-height: 75px; /* Altura mínima para os blocos, ajustável conforme suas imagens */
    }

    /* Ajuste específico para os blocos que contêm duas imagens (2:1) */
    /* No seu HTML, são o 2º e o 4º div dentro de .tm-header-gallery */
    .tm-header-gallery > div:nth-child(2),
    .tm-header-gallery > div:nth-child(4) {
        flex-direction: row; /* Permite que as duas imagens dentro dele fiquem lado a lado */
        flex-wrap: wrap; /* Garante que as imagens se ajustem */
        align-items: stretch; /* Faz com que as imagens preencham a altura disponível */
    }

    /* Estilo para TODAS as imagens dentro dos blocos da galeria */
    .tm-header-gallery img {
        max-width: 100%; /* Garante que a imagem não exceda a largura do seu contêiner */
        height: 100%;    /* Força a imagem a preencher a altura do seu contêiner */
        display: block;  /* Remove espaços extras abaixo da imagem */
        object-fit: cover; /* Garante que a imagem cubra o espaço sem distorcer, cortando se necessário */
        width: 100%; /* Força a imagem a ocupar 100% da largura do seu contêiner */
    }

    /* Ajustes para o bloco da logo e slogan (o 5º div no seu HTML) */
    .tm-site-name {
        position: relative;
        width: 100%; /* Ocupa 100% da largura do seu div pai (que já é 1/3 da galeria) */
        max-width: 100%;
        text-align: center;
        margin: 0; /* Remove margens externas */
        height: 100%; /* Ocupa 100% da altura do seu div pai */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 5px; /* Espaçamento interno */
        box-sizing: border-box;
    }

    .tm-site-name .tm-logo-img {
        max-width: 100%; /* Garante que a logo se ajuste ao seu contêiner */
        height: auto;
        display: block;
        margin: 0 auto; /* Centraliza a imagem da logo */
    }

    .tm-site-name .tm-site-name-h2 {
        font-size: 0.8rem; /* Tamanho menor para o slogan */
        margin-top: 5px;
        color: #fff; /* Exemplo: cor do texto para visibilidade */
        line-height: 1.2;
    }

    /* A ordem dos elementos (order) não é necessária se o HTML já estiver na sequência desejada (1,2,3,4,5,6) */
    /* Se a ordem visual não estiver correta, você precisará adicionar as propriedades 'order' explicitamente */
    /* Exemplo: .tm-header-gallery > div:nth-child(1) { order: 1; } */
}
